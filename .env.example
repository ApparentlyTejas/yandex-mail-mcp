# Create an app password in Yandex ID; NEVER commit the real .env
YANDEX_EMAIL=your-address@yandex.com
YANDEX_APP_PASSWORD=replace-me
YANDEX_IMAP_HOST=imap.yandex.com
YANDEX_IMAP_PORT=993

# Mutating IMAP tools are disabled unless explicitly enabled.
YANDEX_ALLOW_WRITE=false
YANDEX_PROMOTIONS_FOLDER=AI-Promotions

# MCP: stdio is default; HTTP should remain on trusted localhost/proxy only.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional background monitoring (OpenAI API billing is separate from ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
POLL_INTERVAL_SECONDS=180
# Docker Compose overrides this path to /data/mail_state.sqlite3.
STATE_DB=./data/mail_state.sqlite3
AUTO_MOVE_PROMOTIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
